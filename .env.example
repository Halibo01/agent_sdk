# Agent SDK Configuration

# Primary LLM Provider (OpenRouter is used by default in main_ui.py)
OPENROUTER_API_KEY=sk-or-your-api-key-here

# Search Tool API Key
LANGSEARCH_API_KEY=your-langsearch-key-here

# Optional: Other potential providers supported by the SDK
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
